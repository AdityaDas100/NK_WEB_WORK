# ---------------------------------------------------------------------------
# Environment for `docker compose up` (copy to `.env` and edit).
#
#   cp .env.example .env
#   docker compose up --build
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=pharma
POSTGRES_USER=pharma
# Change this before running anywhere real.
POSTGRES_PASSWORD=pharma-local-development-only
POSTGRES_PORT=5432

# --- backend (Spring Boot) -------------------------------------------------
BACKEND_PORT=8080

# Salt used to pseudonymise PII before it reaches a log line. MUST be replaced
# in every deployed environment; the service refuses to start with this value
# under the `prod` profile.
#   openssl rand -base64 48
APP_HASH_SECRET=change-me-in-production-please-32-chars-min

# Origins allowed to call the API directly. The Next.js site proxies the
# submission server-side, so this only needs the public site origin.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Only enable this when the service really sits behind a trusted reverse proxy
# that overwrites X-Forwarded-* (otherwise clients could spoof their own IP).
APP_TRUST_PROXY_HEADERS=false
# Enforce HTTPS redirects. Keep false for local HTTP, true behind a TLS proxy.
APP_REQUIRE_HTTPS=false

# Rate limiting (per client / burst / global, per minute).
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=5
RATE_LIMIT_GLOBAL_PER_MINUTE=600

# --- export ----------------------------------------------------------------
# excel | google-sheets | excel,google-sheets
EXPORT_SINKS=excel
EXPORT_ENABLED=true
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_TOKEN=

# --- frontend (Next.js) ----------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CLIENT_IP_HASH_SECRET=change-me-please-use-openssl-rand-base64-32
