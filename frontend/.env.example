# ---------------------------------------------------------------------------
# Server-side configuration (never exposed to the browser).
# Copy to `.env.local` for local development.
# ---------------------------------------------------------------------------

# Spring Boot intake API. The browser never talks to this URL directly: the
# Next.js route handler at /api/inquiries proxies the submission server-side,
# which keeps the backend off the public internet and avoids CORS entirely.
API_BASE_URL=http://localhost:8080

# Public origin of this site; used for canonical URLs, sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to pseudonymise client IPs in the edge rate limiter and in logs.
# Generate with: openssl rand -base64 32
CLIENT_IP_HASH_SECRET=change-me-please-use-openssl-rand-base64-32

# Timeout for the upstream submission request (milliseconds).
INQUIRY_FORWARD_TIMEOUT_MS=10000

# Per-IP submission limit enforced by the route handler (defence in depth: the
# Spring service enforces its own, independent limit).
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_BURST=2
